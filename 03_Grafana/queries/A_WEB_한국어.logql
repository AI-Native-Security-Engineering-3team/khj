{job="sentinelhub-web"}
| pattern `<ip> - - [<_>] "<method> <path> <_>" <status> <_>`
| line_format `{{ if .status }}[WEB] 접속 IP: {{.ip}} | 요청: {{.method}} {{.path}} | HTTP {{.status}}{{ if eq .status "200" }} OK (요청 성공){{ else if eq .status "201" }} Created (생성 완료){{ else if eq .status "301" }} Moved Permanently (영구 이동){{ else if eq .status "302" }} Found (임시 이동){{ else if eq .status "304" }} Not Modified (변경 없음){{ else if eq .status "400" }} Bad Request (잘못된 요청){{ else if eq .status "401" }} Unauthorized (인증 필요){{ else if eq .status "403" }} Forbidden (접근 금지){{ else if eq .status "404" }} Not Found (페이지 없음){{ else if eq .status "429" }} Too Many Requests (요청 횟수 초과){{ else if eq .status "500" }} Internal Server Error (서버 내부 오류){{ else if eq .status "502" }} Bad Gateway (게이트웨이 오류){{ else if eq .status "503" }} Service Unavailable (서비스 이용 불가){{ end }}{{ else }}[WEB] {{ __line__ }}{{ end }}`
