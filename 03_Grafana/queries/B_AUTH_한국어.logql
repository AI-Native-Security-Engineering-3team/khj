{job="sentinelhub-auth"}
| json ts="timestamp", svc="service", ev="event", uid="username", ip="client_ip"
| line_format `{{- $t := toDateInZone "2006-01-02T15:04:05.999999999Z07:00" "UTC" .ts -}}{{- $kst := (toDateInZone "2006-01-02" "Asia/Seoul" "2006-01-02").Location -}}[AUTH] {{ ($t.In $kst).Format "2006/01/02 15:04" }} {{ .svc }} {{ if eq .ev "LOGIN_SUCCESS" }}로그인성공{{ else if eq .ev "LOGIN_FAILED" }}로그인실패{{ else if eq .ev "LOGOUT" }}로그아웃{{ else }}{{ .ev }}{{ end }} ID: {{ .uid }} IP: {{ .ip }}`
