{job="sentinelhub-fail2ban"}
| regexp `\[(?P<jail>[^\]]+)\]\s+(?P<action>Ban|Unban)\s+(?P<client_ip>\d{1,3}(?:\.\d{1,3}){3})`
| action=~"Ban|Unban"
| line_format `{{ if eq .action "Ban" }}[FAIL2BAN] IP 차단{{ else }}[FAIL2BAN] 차단 해제{{ end }} | IP: {{.client_ip}} | 서비스: {{ if eq .jail "sshd" }}SSH{{ else }}{{.jail}}{{ end }}`
